{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "summonerscourtroom",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "analytics_engine_datasets": [
    {
      "binding": "analytic_engine",
      "dataset": "analytic_events"
    }
  ],
  // Public environment variables.
  // These values are NOT secrets — they are designed to be public or are
  // embedded in the client bundle (VITE_ prefix). Project-specific but safe
  // to commit.
  // Actual secrets (RIOT_API_KEY, SUPABASE_SERVICE_ROLE_KEY, etc.) MUST be
  // set via `wrangler secret put` or the Cloudflare Dashboard — never here.
  // For local overrides during development, use .dev.vars (gitignored).
  "vars": {
    "SUPABASE_URL": "https://gbbbwazmqnqbvcgjhnvz.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_CiDVjfQ4VzII1-vt8w51Sw_ozTpKuLA",
    "VITE_SUPABASE_URL": "https://gbbbwazmqnqbvcgjhnvz.supabase.co",
    "VITE_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_CiDVjfQ4VzII1-vt8w51Sw_ozTpKuLA",
    "VITE_SUPABASE_PROJECT_ID": "gbbbwazmqnqbvcgjhnvz",
    "VITE_TURNSTILE_SITE_KEY": "0x4AAAAAADR21K5nOwdQvXRN",
    "VITE_ENABLE_DEV_CONTEXT": "false"
  }
}

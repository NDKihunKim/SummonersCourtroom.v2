{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "summonerscourtroom",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "analytics_engine_datasets": [
    {
      "binding": "analytic_engine",
      "dataset": "analytic_events"
    }
  ],
  // Public environment variables.
  // For local development, set values in .dev.vars (gitignored).
  // For production, set these in the Cloudflare Dashboard (Workers & Pages >
  // Settings > Variables and Secrets) or via `wrangler secret put`.
  // Actual secrets (RIOT_API_KEY, SUPABASE_SERVICE_ROLE_KEY, etc.) MUST be
  // set via `wrangler secret put` or the Cloudflare Dashboard — never here.
  "vars": {
    "VITE_ENABLE_DEV_CONTEXT": "false"
  }
}

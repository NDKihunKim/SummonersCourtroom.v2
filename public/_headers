# Security headers for static assets served directly by Cloudflare Workers.
# Dynamic SSR routes inject the same headers via app.config.ts.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' https://*.supabase.co https://*.api.riotgames.com https://*.riotgames.com https://ddragon.leagueoflegends.com; font-src 'self'; frame-src 'self' https://challenges.cloudflare.com; base-uri 'self'; form-action 'self'

# Public Supabase client values. These may be exposed to the browser.
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
VITE_SUPABASE_PROJECT_ID="your-project-ref"

# Server-only values. Set these in Cloudflare secrets for production.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
RIOT_API_KEY="RGAPI-your-riot-key"
DEEPSEEK_API_KEY="sk-your-deepseek-key"

# DeepSeek runtime configuration. The API key stays server-only.
DEEPSEEK_MODEL="deepseek-v4-flash"
DEEPSEEK_THINKING="disabled"
# Optional when DEEPSEEK_THINKING="enabled": high or max.
DEEPSEEK_REASONING_EFFORT="high"
# Optional cap for final response + reasoning tokens.
DEEPSEEK_MAX_TOKENS="1400"

# Optional internal-only context inspection token.
# Do not expose this as a VITE_* variable.
ADMIN_CONTEXT_TOKEN="replace-only-if-you-enable-admin-context"

# Cloudflare Turnstile. The site key is public; the secret key stays server-only.
VITE_TURNSTILE_SITE_KEY="0x4AAAA-your-turnstile-site-key"
TURNSTILE_SECRET_KEY="your-turnstile-secret-key"

# Production default: leave unset or false.
VITE_ENABLE_DEV_CONTEXT="false"

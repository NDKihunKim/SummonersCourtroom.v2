# ╔══════════════════════════════════════════════════════════════╗
# ║  TEMPLATE ONLY — replace placeholders with your own values.  ║
# ║  Never commit real secrets to this file.                     ║
# ║  See scripts/check-secrets.sh for pre-push secret scanning.  ║
# ╚══════════════════════════════════════════════════════════════╝

# ── PUBLIC (safe to commit, exposed to browser) ──

# Public Supabase client values. These may be exposed to the browser.
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
VITE_SUPABASE_PROJECT_ID="your-project-ref"

# Cloudflare Turnstile site key — public by design.
VITE_TURNSTILE_SITE_KEY="0x4AAAA-your-turnstile-site-key"

# Production default: leave unset or false.
VITE_ENABLE_DEV_CONTEXT="false"

# ── SECRET (never commit, use wrangler secret put for production) ──

# Server-only Supabase values.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Riot API key — use the development key (starts RGAPI-) for localhost.
# Get a production key separately from the Riot Developer Portal.
RIOT_API_KEY="RGAPI-your-riot-key"

# Private AI gateway.
AI_GATEWAY_URL="https://your-private-ai-gateway.example.com/verdict"
AI_GATEWAY_TOKEN="your-private-ai-gateway-token"

# Turnstile secret key — server-side only.
TURNSTILE_SECRET_KEY="your-turnstile-secret-key"

# Optional internal-only context inspection token.
# Do not expose this as a VITE_* variable.
ADMIN_CONTEXT_TOKEN="replace-only-if-you-enable-admin-context"

# ─────────────────────────────────────────────────────────
# Local development setup
# ─────────────────────────────────────────────────────────
#
# .env.local — for TanStack / Vite local dev server
#   1. Copy this file to .env.local
#   2. Fill in real values
#   3. .env.local is gitignored AND excluded from Time Machine
#
# .dev.vars — for Cloudflare Workers local dev (wrangler dev)
#   1. Copy the wrangler vars block values (SUPABASE_URL, etc.) to .dev.vars
#   2. .dev.vars is gitignored — never commit it
